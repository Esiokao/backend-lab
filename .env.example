# ─────────────────────────────────────────────────────────────
# Backend Lab — 本地開發環境變數範本
#
# 快速開始：跑 scripts/setup-dev.ps1（Windows）或 scripts/setup-dev.sh
# （macOS/Linux）會複製本檔為 .env 並自動生成 secret 值。
# 手動方式：複製本檔為 .env，把所有 CHANGE_ME 換成任意隨機字串
#（例如 openssl rand -hex 32）。
#
# ⚠️ 本地值不需要是「好的密碼」——它們只保護你的本機容器。
#    絕對不要把任何正式環境的 secret 填進這裡。
# ─────────────────────────────────────────────────────────────

# PostgreSQL container initialization
POSTGRES_USER=admin
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=backend_lab

# ── FastAPI / local development（Windows host 直連 DB 用）──
DATABASE_URL=postgresql+psycopg://admin:CHANGE_ME@localhost:5432/backend_lab

# Alembic migration account
MIGRATION_DATABASE_URL=postgresql+psycopg://admin:CHANGE_ME@localhost:5432/backend_lab

# PostgreSQL admin connection for infrastructure scripts
ADMIN_DATABASE_URL=postgresql://admin:CHANGE_ME@localhost:5432/backend_lab

# ── API container database connection（compose 內部網路走服務名 postgres）──
API_DB_USER=app_user
API_DB_PASSWORD=CHANGE_ME
API_DB_NAME=backend_lab

# ── Secrets（本地任意隨機字串即可；正式環境由 CI secrets 注入真值）──
JWT_SECRET=CHANGE_ME

# ── Redis（本地 dev 無密碼——client 端偵測未設 = 不認證）──
REDIS_HOST=localhost
REDIS_PORT=6379

# ── API 防護預設值 ──
DEFAULT_RATE_LIMIT=5
DEFAULT_RATE_LIMIT_WINDOW=60
DEFAULT_MAX_REQUEST_SIZE=1048576

# SQL_ECHO=true
